{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://edrlab.github.io/catalog-registry/schema/feed.schema.json",
  "title": "Catalog Registry Feed",
  "type": "object",
  "properties": {
    "metadata": {
      "description": "Contains feed-level metadata such as title or number of items",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "itemsPerPage": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "currentPage": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "numberOfItems": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "title"
      ]
    },
    "links": {
      "description": "Feed-level links such as search, geoloc or pagination",
      "type": "array",
      "items": {
        "$ref": "https://readium.org/webpub-manifest/schema/link.schema.json"
      },
      "uniqueItems": true,
      "minItems": 1,
      "contains": {
        "properties": {
          "rel": {
            "anyOf": [
              {
                "type": "string",
                "const": "self"
              },
              {
                "type": "array",
                "contains": {
                  "const": "self"
                }
              }
            ]
          }
        },
        "required": [
          "rel"
        ]
      }
    },
    "catalogs": {
      "type": "array",
      "items": {
        "$ref": "catalog.schema.json"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "metadata",
    "links",
    "catalogs"
  ]
}
